# ATHAR configuration — every variable the code reads (SPEC §18.2). Copy to .env.
# Values here are for running on the host (make test, uv run athar ...). docker-compose
# overrides DATABASE_URL / LEDGER_RPC_URL / OLLAMA_URL with compose-network hostnames.

# --- estate / simulation ------------------------------------------------------
ATHAR_SEED=42                 # tuning seed (constants are tuned here)
ATHAR_EVAL_SEED=7             # held-out seed (precision/recall reported here)
ATHAR_MONTHS=12
ATHAR_IDENTITIES=500
# ATHAR_DEV=true allows every example credential below — that is the `make demo` path.
# With ATHAR_DEV=false the app refuses to start unless all of these are changed from the values
# in this file: JWT_SECRET (and it must be at least 32 characters), DEMO_ANALYST_PASSWORD,
# DEMO_APPROVER_PASSWORD, DEMO_JUDGE_PASSWORD, and COOKIE_SECURE (must be true).
ATHAR_DEV=true                # set false when hosting
ATHAR_DATA_DIR=data

# --- storage ------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://athar:athar@localhost:5432/athar
POSTGRES_PASSWORD=athar       # compose only

# --- auth ---------------------------------------------------------------------
JWT_SECRET=change-me-athar-dev-secret   # refused unless ATHAR_DEV=true
JWT_TTL_HOURS=12
DEMO_ANALYST_PASSWORD=analyst-demo-pass
DEMO_APPROVER_PASSWORD=approver-demo-pass
DEMO_JUDGE_PASSWORD=judge-demo-pass
COOKIE_SECURE=false           # true behind Caddy/TLS
# Proxies allowed to set X-Forwarded-For, as comma-separated addresses or CIDRs. Empty means the
# rate limiter ignores the header and keys on the direct peer — the right answer for `athar serve`
# and the Vite dev proxy, where every request already looks like it comes from loopback, and the
# safe default under compose (one shared login bucket rather than a spoofable per-IP one).
# Behind a reverse proxy, name that proxy's own address so each client gets its own bucket; a
# range wide enough to include anything else that can reach the API port makes the header
# forgeable again (the published API port is reached through the Docker gateway address).
TRUSTED_PROXY_CIDRS=

# --- LLM (agents explain; the rule engine decides) -----------------------------
LLM_PROVIDER=gemini           # gemini | ollama | none  (fallback chain gemini → ollama → none)
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# Accepted as an alias for GEMINI_API_KEY (the name the google-genai SDK itself looks for).
# GEMINI_API_KEY wins when both are set; leave both empty to run the template fallback.
GOOGLE_API_KEY=
OLLAMA_URL=http://localhost:11434
# Docker only: what the api container uses instead of OLLAMA_URL. Defaults to the `local-llm`
# profile's container; set it to http://host.docker.internal:11434 to use an Ollama already
# running on your machine (then pick a model you have pulled in OLLAMA_MODEL).
OLLAMA_URL_DOCKER=
OLLAMA_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=20
LLM_MAX_CONCURRENCY=3

# --- governance ledger (local Anvil) -------------------------------------------
LEDGER_ENABLED=true
LEDGER_RECEIPT_TIMEOUT_SECONDS=60   # how long a commit waits for its receipt before parking the job
LEDGER_RPC_URL=http://localhost:8545
# DEV ONLY — Anvil dev account #0. This key is PUBLICLY KNOWN and holds nothing of value.
LEDGER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Leave empty to deploy on the first API start; the address is then persisted in ledger_meta.
LEDGER_CONTRACT_ADDRESS=

# --- detection thresholds (defaults; editable on the Settings page) -------------
DORMANT_DAYS=90
STALE_KEY_DAYS=180
APPROVED_REGIONS=me-central-1,uaenorth,uaecentral,me-central1
AUTO_REMEDIATE_DEPARTED=false

# --- serving ------------------------------------------------------------------
SCAN_INTERVAL_MINUTES=0       # 0 = manual
PUBLIC_URL=http://localhost:8080
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=10485760
# Serve deterministic in-memory fixtures instead of querying the database. Frontend development
# only: it lets `npm run dev` work with no Postgres, and it is never the demo or hosted path.
ATHAR_API_MOCK=false

# --- compose only -------------------------------------------------------------
# Host ports the compose services publish. Change one when something already owns that port on
# the host; the port *inside* the network never moves, so nothing else needs to follow.
POSTGRES_HOST_PORT=5432
ANVIL_HOST_PORT=8545
API_HOST_PORT=8000
WEB_HOST_PORT=8080
# The vhost Caddy answers on under `--profile public` (deploy/Caddyfile). Set it to the public
# hostname before `docker compose --profile public up`, or Caddy serves `localhost` with a
# self-signed certificate. Keep it in step with PUBLIC_URL above.
PUBLIC_HOSTNAME=localhost

# --- Docker only: who the api container runs as --------------------------------
# `make up` exports your own ids into these so the ./data bind mount is writable: Docker on Linux
# creates a missing bind-mount source owned by root, which the image's own uid 10001 cannot write.
# Left empty they fall back to that uid, which is right when data/ is already writable — and the
# shell environment wins over this file, so `make up` overrides whatever is here.
# Comments sit on their own line: a trailing one becomes part of the value.
ATHAR_UID=
ATHAR_GID=
